import pandas as pd

# Load the dataset
df = pd.read_csv("ipl-matches.csv")

# 1. Basic info about dataframe
print(df.info())

# 2. List out all matches gone in superover
superover_matches = df[df['SuperOver'] == 'Y']
print(superover_matches[['ID','City','Date','Team1','Team2','WinningTeam']])

# 3. How Many Matches won by Chennai Super Kings at Kolkata
csk_kolkata_wins = df[(df['WinningTeam'] == 'Chennai Super Kings') & (df['City'] == 'Kolkata')]
print("CSK wins at Kolkata:", len(csk_kolkata_wins))

# 4. In How Many Matches MS Dhoni is Player of Match Vs Mumbai Indians
dhoni_vs_mi = df[(df['Player_of_Match'] == 'MS Dhoni') & 
                 ((df['Team1'] == 'Mumbai Indians') | (df['Team2'] == 'Mumbai Indians'))]
print("Dhoni Player of Match vs MI:", len(dhoni_vs_mi))

# 5. Display list of all matches in which Gujarat Titans won the Toss, Elected to Bat and won
gt_toss_bat_win = df[(df['TossWinner'] == 'Gujarat Titans') & 
                     (df['TossDecision'] == 'bat') & 
                     (df['WinningTeam'] == 'Gujarat Titans')]
print(gt_toss_bat_win[['ID','City','Date','Team1','Team2','WinningTeam']])

# 6. Display list of all matches won by Gujarat Titans
gt_wins = df[df['WinningTeam'] == 'Gujarat Titans']
print(gt_wins[['ID','City','Date','Team1','Team2','WinningTeam']])


